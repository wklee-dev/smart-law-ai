# RPA-03 웹+DB 통합 — 이 파일을 .env.local 로 복사 후 비밀번호만 채우세요
# 비밀번호는 깃/채팅에 넣지 마세요.

# --- 권장: 비밀번호 분리 (특수문자 # @ / ? 등도 안전) ---
SMART_LAW_PG_HOST=127.0.0.1
SMART_LAW_PG_PORT=5432
SMART_LAW_PG_USER=postgres
SMART_LAW_PG_PASSWORD=여기실제비밀번호
SMART_LAW_PG_DATABASE=smart_law_ai

# (선택) URL 방식 — 비밀번호에 특수문자 있으면 위의 분리 방식 사용
# SMART_LAW_DATABASE_URL=postgresql://postgres:비밀번호@127.0.0.1:5432/smart_law_ai

# 첨부파일 다운로드 루트 (RPA-03 고정)
SMART_LAW_ATTACH_ROOT=C:/SQLiteDB

# WEEKLY_CRAWLERS_DIR 은 run.ps1 이 패키지 내 scripts\crawlers 로 자동 설정
# WEEKLY_CRAWLER_PYTHON=python

# --- 로그인 (Smart-Law-Hanjoo CAS 로그인) ---
# 세션 서명 키: 임의의 긴 문자열 (주간 크롤 예약작업 토큰으로도 사용)
AUTH_SECRET=여기임의의긴문자열
# 관리자는 화면 [관리 > 관리자 등록]에서 지정 (wklee 는 항상 admin)
# 저장 파일 기본: C:/SQLiteDB/smart_law_admin_users.json
# ADMIN_USERS_JSON_PATH=C:/SQLiteDB/smart_law_admin_users.json
# CAS DB 연결 실패 시에만 로컬 계정 허용 (기본 false)
AUTH_ALLOW_LOCAL=false

# --- CAS (PMKSystem) MSSQL ---
# CAS_TARGET=LIVE → 203.242.224.24 / DEV → 203.242.224.16 (DB_HOST_LIVE·DB_HOST_DEV 로 덮어쓰기 가능)
CAS_TARGET=LIVE
DB_HOST_LIVE=
DB_HOST_DEV=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

PORT=3000
HOSTNAME=0.0.0.0

TARIFF_YEAR=2026
TARIFF_COUNTRY=KR
