# --- Supabase ---
# WARNING: 
pm run supabase:db-reset wipes ALL local DB data (laws, hs_chunks, etc.).
# New schema only: 
pm run supabase:migration-up (keeps existing rows).
# Backup example: pg_dump postgresql://postgres:postgres@127.0.0.1:54328/postgres -Fc -f backup.dump

# --- Supabase API (@supabase/supabase-js · PostgREST) ---
# 로컬: 
pm run supabase:start 후 CLI 출력·config.toml 확인. API 주소는 Windows 포트 충돌을 피하기 위해 API 기본을 54340으로 둠.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54340
# 서버 전용(선택). 비우면 NEXT_PUBLIC_SUPABASE_URL을 사용합니다.
SUPABASE_URL=http://127.0.0.1:54340
# 로컬: npm run supabase:status 의 Secret
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres 직접 접속 (DBeaver, pg_dump, pg_restore) ---
# 비밀번호는 
pm run supabase:status 의 Database URL과 맞추세요(기본 postgres인 경우가 많음).
SUPABASE_DB_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54328/postgres

# --- 품목분류 국내사례 (SQLite classification_cases · case_images) ---
# 기본값: D:/SQLiteDB/domestic_hs_class.db
# DOMESTIC_HS_CLASS_DB_PATH=D:/SQLiteDB/domestic_hs_class.db
# 2006이후 체크 시: D:/SQLiteDB/domestic_hs_class_2006_2026.db
# DOMESTIC_HS_CLASS_DB_PATH_SINCE_2006=D:/SQLiteDB/domestic_hs_class_2006_2026.db

# --- 품목분류 외국사례 (SQLite foreign_cases · case_images) ---
# 기본값: D:/SQLiteDB/hsforeigncase.db
# FOREIGN_HS_CASE_DB_PATH=D:/SQLiteDB/hsforeigncase.db
# local_path 가 상대경로일 때 기준(비우면 DB 파일과 같은 폴더)
# FOREIGN_HS_CASE_ATTACH_ROOT=D:/SQLiteDB

# --- 행정규칙 조회 (SQLite) ---
# 목록: DB 의 rule_config.description. 기본 DB: D:/SQLiteDB/admin_rules.db
# ADMIN_RULES_DB_PATH=D:/SQLiteDB/admin_rules.db
# ADMIN_RULES_ATTACH_ROOT=D:/SQLiteDB
# (옵션) law_crawler config.json 경로 — 목록에는 미사용
# ADMIN_RULES_CONFIG_PATH=D:/CursorProject/law_crawler/config.json
# 조회 화면 [크롤링] → D:\Crawling\law_crawler\crawler.py
# ADMIN_RULES_CRAWLER_DIR=D:/Crawling/law_crawler
# PYTHON_PATH=python

# --- 관세법령정보포털 · CLIP 행정규칙 (통합 목록 SQLite) ---
# 기본값: D:/SQLiteDB/clip_admin_rule.db  (테이블: admin_rule, admin_rule_history)
# CLIP_ADMIN_RULE_DB_PATH=D:/SQLiteDB/clip_admin_rule.db
# 첨부 루트(향후 파일 연동) — ATTACH
# CLIP_ADMIN_RULE_ATTACH_ROOT=D:/SQLiteDB/ATTACH

# --- 일반법령 / Hanjoo 조회 DB ---
# 기본값(SQLite): D:/SQLiteDB/smart_law_ai.db
# SMART_LAW_SQLITE_DB_PATH=D:/SQLiteDB/smart_law_ai.db
#
# Postgres (RPA-03 배포: 같은 PC면 127.0.0.1)
# 비밀번호는 채팅·깃에 넣지 말고 .env.local 에만 설정
# SMART_LAW_DATABASE_URL=postgresql://postgres:비밀번호@127.0.0.1:5432/smart_law_ai
# 첨부 루트 (RPA-03: C:/SQLiteDB)
# SMART_LAW_ATTACH_ROOT=C:/SQLiteDB
# 배포: 개발PC에서 npm run pack:rpa03 → RPA-03에서 run.ps1 만 실행 (deploy/rpa-03/README.md)

# --- 국가법령정보 OPEN API (scripts/openlawapi · Python) ---
# LAW_API_OC=
# LAW_XMLSERVICE_URL=http://law.go.kr/DRF/lawSearch.do
# LAW_JSONSERVICE_URL=http://law.go.kr/DRF/lawService.do
# LAW_DB_PATH=D:/SQLiteDB/smart_law_ai.db
# LAW_ATTACH_DIR=D:/SQLiteDB/attach/smartlawai
# SMART_LAW_API_DIR=scripts/openlawapi (기본값: 상대경로로 가능)
# PYTHON_PATH=python
# OPENLAWAPI_NONINTERACTIVE=1

# --- 관세율표 SQLite (tariff_section/chapter/heading/item) ---
# TARIFF_SCHEDULE_DB_PATH=D:/SQLiteDB/smart_law_ai.db
# 벡터 적재 스크립트 기본(scripts/tariff-chunks.ps1): 연도 2026, 국가 KR
# TARIFF_YEAR=2026
# TARIFF_COUNTRY=KR
# TARIFF_EMBED_BATCH_LIMIT=20
# TARIFF_EMBED_DELAY_SEC=3

# 아래 필요한 키만 설정
# GEMINI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_OUTPUT_DIMENSIONALITY=768

# --- RAG API Ops (STEP 10-4D) ---
# DEBUG=false
# LOG_LEVEL=INFO
# ENABLE_CITATION=true
# ENABLE_RANKING=true
# ENABLE_KEYWORD_SEARCH=true
# ENABLE_HYBRID_SEARCH=true
# ENABLE_REQUEST_LOG=true
# ENABLE_PERFORMANCE_LOG=true
# MAX_QUERY_LENGTH=2000
# MAX_CONTEXT_LENGTH=20000
# REQUEST_TIMEOUT_SECONDS=60
# API_TIMEOUT_SECONDS=55
# ALLOW_ORIGINS=http://localhost:3000,https://smartlaw.example.com
# RAG_BUILD=dev
# RAG_API_BASE_URL=http://127.0.0.1:8000
# RAG_API_TIMEOUT_MS=55000

# --- CAS&NCOM / Hanjoo Gateway (거래처 조회) ---
# CAS_NCOM_API_BASE_URL=http://127.0.0.1:5050
# HANJOO_GATEWAY_API_URL=http://127.0.0.1:5050
# HANJOO_API_KEY_SHIPMENT_TRACKING=

# --- 로그인 (Smart-Law-Hanjoo 통합, proxy.ts) ---
# 세션 서명 키 (미설정 시 dev-secret). 주간 크롤 예약작업 토큰으로도 사용
AUTH_SECRET=
# 관리자는 화면 [관리 > 관리자 등록]에서 지정 (wklee 는 항상 admin)
# ADMIN_USERS_JSON_PATH=D:/SQLiteDB/smart_law_admin_users.json
# CAS DB 연결 실패 시에만 로컬 계정(AUTH_USER_ID/AUTH_PASSWORD) 허용
AUTH_ALLOW_LOCAL=false
# CAS MSSQL: CAS_TARGET=LIVE 면 DB_HOST_LIVE, 아니면 DB_HOST_DEV (없으면 DB_HOST)
# CAS_TARGET=DEV
# DB_HOST_LIVE=
# DB_TRUST_SERVER_CERTIFICATE=true