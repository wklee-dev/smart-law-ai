# .env.example을 .env로 복사한 뒤 실제 값을 입력하세요.
# Windows PowerShell: Copy-Item env.example .env
# macOS/Linux:      cp env.example .env

# 유니패스 일반 사용자 로그인 정보
UNIPASS_ID=
UNIPASS_PW=

# SQLite DB 파일 경로
# Windows 예: DB_PATH=D:\SQLiteDB\unipass_bunsuk.db
# macOS/Linux 예: DB_PATH=/home/user/unipass_bunsuk.db
DB_PATH=D:\SQLiteDB\unipass_bunsuk.db

# 선택 설정: 비워 두면 프로젝트의 logs/ 및 downloads/전자등기우편발송목록/을 사용합니다.
# LOG_DIR=
# DOWNLOAD_DIR=
