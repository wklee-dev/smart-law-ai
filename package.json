{
  "name": "smart-law-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=12288 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "node --max-old-space-size=12288 ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run dev",
    "dev:loop": "node scripts/dev-loop.mjs",
    "build": "next build",
    "start": "next start",
    "start:rpa03": "next start -H 0.0.0.0 -p 3000",
    "pack:rpa03": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/rpa-03/pack.ps1",
    "lint": "eslint",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:db-reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-db-reset-warn.ps1",
    "supabase:migration-up": "npx supabase migration up",
    "hs-chunks:ingest-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1",
    "hs-chunks:embed-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -EmbedOnly",
    "hs-chunks:ingest-2022-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -Year 2022",
    "hs-chunks:embed-2022-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -Year 2022 -EmbedOnly",
    "hs-chunks:ingest-2017-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -Year 2017",
    "hs-chunks:embed-2017-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -Year 2017 -EmbedOnly",
    "hs-chunks:ingest-2012-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -Year 2012",
    "hs-chunks:embed-2012-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -Year 2012 -EmbedOnly",
    "hs-chunks:ingest-2007-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -Year 2007",
    "hs-chunks:embed-2007-wco": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hs-chunks-wco.ps1 -Year 2007 -EmbedOnly",
    "tariff-chunks:ingest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tariff-chunks.ps1",
    "tariff-chunks:embed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tariff-chunks.ps1 -EmbedOnly",
    "tariff-chunks:ingest-kr-2026": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tariff-chunks.ps1 -Year 2026 -CountryCode KR",
    "tariff-chunks:embed-kr-2026": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tariff-chunks.ps1 -Year 2026 -CountryCode KR -EmbedOnly",
    "api-management:sort": "python scripts/sort-api-management-json.py",
    "api-management:export-excel": "python scripts/export-api-management-to-excel.py",
    "api-management:import-excel": "python scripts/import-api-management-from-excel.py",
    "processing-status:extract": "python scripts/extract_data_processing_status.py",
    "processing-status:watch": "node scripts/watch_data_processing_status.mjs",
    "api-management:fetch-law-ids": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-law-ids-batch.ps1",
    "openlawapi:install": "pip install -r scripts/openlawapi/requirements.txt",
    "openlawapi:fetch": "python scripts/openlawapi/law_crawler.py --list-apis"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.40",
    "@langchain/google-genai": "^2.1.27",
    "@supabase/supabase-js": "^2.103.0",
    "exceljs": "^4.4.0",
    "langchain": "^1.3.3",
    "mssql": "^12.7.0",
    "next": "16.2.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
